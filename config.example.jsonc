// omp-warden config (JSON). The live file is plain JSON at:
//   $PI_CODING_AGENT_DIR/omp-warden/config.json   (default ~/.omp/agent/omp-warden/config.json)
// A YAML file (config.yaml) is also supported and is nicer for multi-line questions — see
// config.example.yaml. Everything is optional; drop these comments for real JSON. A config with
// any error is ignored as a whole (defaults used), so a typo can't half-apply.
{
  "enabled": true,
  "debug": false,

  // Models are chosen by omp model role; set a role to null to disable that stage.
  "judgeRole": "judge",     // stage 1 classifier (a native judge)
  "llmRole": "smol",        // stage 2 for the unsure band; falls back to the "default" role

  "onNoAnswer": "block",    // judge can't answer: "block" | "ask" | "allow"
  "includeContext": true,   // send the conversation so already-authorized calls aren't re-asked
  "timeoutMs": 20000,
  "maxTokens": 512,

  // Every matching rule is scored in one request; worst verdict wins. Per rule, by risk:
  //   < allowBelow run; [allowBelow, askAbove) unsure -> llm; >= askAbove ask; > blockAbove block.
  "rules": [
    {
      "name": "auto-mode",
      "description": "General safety check",
      "tools": ["*"],
      "type": "choice",      // allow/ask/block (risk = 1 - P(allow)); built-in policy unless overridden
      "allowBelow": 0.1,
      "askAbove": 0.2
      // "blockAbove" omitted -> ask-only
    },
    {
      "name": "data-exfiltration",
      "description": "Sending data to an untrusted destination",
      "tools": ["bash", "web_fetch", "fetch", "http"],
      "type": "noul",        // yes/no hazard (risk = P(yes)); inferred when "question" is present
      "question": "Does this send code, data, logs, env vars or files to a third party, an unknown host, a paste/share site, or a public destination?",
      "yes": "Data leaves the user's trusted systems.",
      "no": "Nothing leaves the user's trusted systems.",
      "allowBelow": 0.1,
      "askAbove": 0.3,
      "blockAbove": 0.8
    }
  ]
}
