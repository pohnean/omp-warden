// Every key of the live config, with its default. Everything is optional — omit a key to use its
// default. The live config file is plain JSON at:
//   $PI_CODING_AGENT_DIR/omp-warden/config.json   (default ~/.omp/agent/omp-warden/config.json)
// Drop these comments and keep only the keys you change. A config with any error is ignored as a
// whole (the defaults are used), so a single typo can never half-apply.
//
// The scalar keys (enabled, debug, judgeRole, llmRole, onNoAnswer) can also be set through
// `omp /settings` -> Plugins -> omp-warden, or `omp plugin config`; those override this file.
// The arrays (whitelist, rules) are file-only.
{
  // Turn the gate on or off. When off, omp's native approval decides alone.
  "enabled": true,

  // Print a line to chat for each call checked, including the classifier's score. Handy while
  // tuning thresholds or seeing what the classifier decided.
  "debug": false,

  // The two stages are independent. Set a role to a model role, or to null to turn that stage off:
  //   both set        -> classifier, then the llm for the uncertain middle band
  //   judgeRole only  -> classifier only (block above blockAbove, otherwise run)
  //   llmRole only    -> the llm judges every in-scope call
  //   both null       -> nothing scored; native approval decides

  // Stage 1: the omp model role that scores risk. Point it at a local native judge, e.g.
  //   modelRoles:
  //     judge: local/lfm2-1.2b
  // Use null to disable the classifier stage.
  "judgeRole": "judge",

  // Stage 2: the omp model role whose chat model decides. Falls back to the "default" role when
  // this one is unset in omp. Use null to disable the llm stage.
  "llmRole": "smol",

  // What a stage that should answer but cannot falls back to (model down, timeout, not a judge):
  // "block" (default), "ask" (prompt if there is a UI), or "allow".
  "onNoAnswer": "block",

  // Per-model-call timeout, in milliseconds.
  "timeoutMs": 20000,

  // Reply budget for the stage-2 chat model.
  "maxTokens": 512,

  // Optional. Tools that are never scored (native omp approval still applies). Omit to use the
  // built-in default: read, grep, glob, find, ast_grep, lsp, todo, ask, task, think, wait, yield.
  // "whitelist": ["read", "grep", "glob"],

  // Rules are tried in order; the first whose `tools` match the call decides it. A call matching
  // no rule is left entirely to native approval.
  "rules": [
    {
      "name": "default",

      // Tool-name patterns: "*" matches every tool, "prefix*" matches by prefix, or an exact name.
      "tools": ["*"],

      // Risk in [0, 1]: risk < allowBelow runs; risk > blockAbove is blocked; a risk between the
      // two goes to the stage-2 chat model (or just runs, when there is no llm stage).
      "allowBelow": 0.2,
      "blockAbove": 0.8,

      // The yes/no question the stage-1 judge answers about the call.
      "question": "Could this tool call exfiltrate data, change a production system, or destroy data that the user did not explicitly ask to change?",

      // Whether stage 1 also sees a transcript of the conversation, not just the command.
      "includeContext": true
    }
  ]
}
